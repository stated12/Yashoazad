# Supabase (new project for this site). Server-side only: never prefix the service key with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Yashovardhan Azad Website <enquiries@yashoazad.in>"
ENQUIRY_TO_EMAIL=yashoazad@ymail.com

# Public address of the site (used for sitemap and sharing)
NEXT_PUBLIC_SITE_URL=https://yashoazad.in

# Long random string used to anonymise IP addresses for rate limiting
ENQUIRY_SECRET=

# Author Publishing System (see docs/AUTHOR_SETUP.md)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTHOR_EMAIL=
# Optional. If empty, ENQUIRY_SECRET is used to sign the author sign-in cookie (must be 16+ characters)
AUTHOR_SESSION_SECRET=

# Reserved for the Razorpay phase (leave empty for now)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
